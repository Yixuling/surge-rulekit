{
  "permissions": {
    "ask": ["Bash(bun run deploy:*)", "Bash(bun src/cli/deploy.ts:*)"]
  },
  "hooks": {
    "PreToolUse": [{
      "matcher": "Edit|Write",
      "hooks": [{
        "type": "command",
        "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/block-generated-edits.sh\""
      }]
    }]
  }
}
