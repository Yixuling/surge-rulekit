.DS_Store

# 依赖（bun install：@types/bun 与 typescript，供编辑器和 CI 类型检查）
/node_modules/

# 渲染产物（bun run render）
/dist/

# 私有层：变量、片段、部署基准、维护笔记（备份在 1Password，见 bun run private:backup）
/private/

# Claude Code：settings.json 与项目技能入库共享；本地覆盖与 Surge 技能软链（bun run hooks 建立）不入库
/.claude/settings.local.json
/.claude/skills/surge
