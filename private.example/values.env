# 复制 private.example/ 为 private/ 后填入真实值。
# 模板变量。SECRET_* 的值会进入提交扫描清单；太短或太常见、会误报的值不要用 SECRET_ 前缀，改在 deny.txt 加带上下文的片段。

# 订阅地址（📡 Subscription 的 policy-path）
SECRET_SUB_URL=https://example.com/your-subscription
# 两家机场：节点名中能区分它们的关键词，同时用作策略组名
SECRET_PRIMARY_AIRPORT=AirportA
SECRET_BACKUP_AIRPORT=AirportB
# 专线/独享 IP 节点的标识关键词（主力机场的地区 Smart 组会排除它们，单独进 🚄 Static）
SECRET_STATIC_KEYWORD=Special
# 机场子集组的图标
PRIMARY_AIRPORT_ICON=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Airport.png
BACKUP_AIRPORT_ICON=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Airport.png
# HTTP API 密钥，建议随机串
HTTP_API_KEY=change-me
# skip-proxy 追加条目（如有反代理检测的银行 App 域名）
SKIP_PROXY_EXTRA=*.example-bank.com
# MITM CA：在 Surge 的 MITM 设置中生成后填入
SECRET_CA_PASSPHRASE=passphrase
SECRET_CA_P12=p12-base64
